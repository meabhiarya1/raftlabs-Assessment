{
  "name": "order-management-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/ensure-env.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "build": "node -e \"console.log('No build step required for this JavaScript backend.')\"",
    "prestart": "node scripts/ensure-env.js",
    "start": "node --env-file=.env src/server.js",
    "test": "vitest run",
    "pretest:db": "node scripts/ensure-env.js",
    "test:db": "RUN_REAL_DB_TESTS=true node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/integration/app.real-db.test.js",
    "test:all": "npm test && npm run test:db",
    "test:coverage": "vitest run --coverage",
    "predb:migrate": "node scripts/ensure-env.js",
    "db:migrate": "node --env-file=.env scripts/migrate.js",
    "predb:seed": "node scripts/ensure-env.js",
    "db:seed": "node --env-file=.env scripts/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "fastify": "^5.2.1",
    "mysql2": "^3.15.3",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.1.1",
    "vitest": "^3.1.1"
  }
}
