# This file is copied to `.env` automatically if `.env` is missing.
# It is used by:
# - npm run dev
# - npm run start
# - npm run db:migrate
# - npm run db:seed
#
# Update the database values below to match your local MySQL or AWS RDS MySQL credentials.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=order_management
DB_USER=root
DB_PASSWORD=your_mysql_password
API_KEY=development-api-key

# Comma-separated values are supported if you want to allow multiple frontend URLs.
CORS_ORIGIN=http://localhost:5173
AUTO_MIGRATE_DB=true
AUTO_SEED_MENU=true
ORDER_STATUS_SIMULATION_ENABLED=true
ORDER_STATUS_STEP_MS=15000
STATUS_POLL_INTERVAL_MS=5000
DB_POOL_LIMIT=10
LOG_LEVEL=info
